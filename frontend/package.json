{
  "name": "ic-imajev-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && node scripts/prepare-cf-output.mjs && cf deploy --prebuilt",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types scripts/check-tokenizer.mjs && playwright test",
    "prepare:tokenizer": "node scripts/prepare-tokenizer.mjs",
    "predev": "npm run prepare:tokenizer",
    "prebuild": "npm run prepare:tokenizer",
    "test:tokenizer": "node --experimental-strip-types scripts/check-tokenizer.mjs",
    "pretest": "npm run prepare:tokenizer"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.8.2",
    "@cloudflare/config": "0.20.0",
    "@mizchi/vlmkit": "^0.23.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cf": "1.0.0-beta.12",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
