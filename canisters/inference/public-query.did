// Public browser inference query subset; owner/update APIs are excluded.
// Canister: xis3j-paaaa-aaaai-axumq-cai
// Module hash: 8fd78b39b4ab626b4623826c162275737d875b7df25341d1aa2852d6e50a546c
// Opaque blobs require the five-token prefix frame/carry protocol, not plain text.
service : {
  runAttentionInferenceStep : (blob, nat32) -> (variant {Ok:record {kv:blob; instructions:nat64; spans:vec record {text; nat64}; state:blob; stable_read_bytes:nat64; previous_hidden:blob; stable_pages:nat64; heap_pages:nat64}; Err:text}) query;
  runDeltaInferenceStep : (blob, blob, nat32, nat32) -> (variant {Ok:record {conv:blob; instructions:nat64; spans:vec record {text; nat64}; state:blob; stable_read_bytes:nat64; previous_hidden:blob; stable_pages:nat64; heap_pages:nat64}; Err:text}) query;
  getModelStatus : () -> (record {model:text; hashed:nat64; bytes:nat64; chunks:vec nat64; pack_hash:text; received:nat64; ready:bool}) query;
  runInferenceStep : (blob) -> (variant {Ok:record {instructions:nat64; state:blob; stable_read_bytes:nat64; stable_pages:nat64; heap_pages:nat64}; Err:text}) query;
  runFinalInferenceStep : (blob, vec text) -> (variant {Ok:record {decision:record {abstained:bool; unknown_probability:float32; probabilities:vec float32; value:opt text; calibration_version:text; instructions:nat64; raw_logits:vec float32}; measurement:record {instructions:nat64; state:blob; stable_read_bytes:nat64; stable_pages:nat64; heap_pages:nat64}}; Err:text}) query;
  getWeightCacheStatus : () -> (record {activation_bytes:opt nat64; rope_bytes:opt nat64; paired_weight_bytes:opt nat64; names:vec text; preparation_instructions:nat64; bytes:nat64}) query;
}
